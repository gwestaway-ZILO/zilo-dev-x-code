{
  "name": "@google/gemini-cli-mobile-session-manager",
  "version": "0.4.0",
  "type": "module",
  "description": "Mobile application for DevX CLI session management and tool approval",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "bundle": "npm run build:server && npm run build",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/gemini-cli-core": "*",
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "qrcode": "^1.5.3",
    "cors": "^2.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "bonjour-service": "^1.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/qrcode": "^1.5.5",
    "@types/cors": "^2.8.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}